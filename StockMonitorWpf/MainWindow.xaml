<Window x:Class="StockMonitorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="监测系统"
        Width="980"
        Height="620"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="监测系统" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="实时监测指定股票价格，触达上下限时提醒" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="#EAF1FF" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStatusText" Text="未开始" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="监测参数" FontSize="18" FontWeight="Bold" Margin="0,0,0,18" />

                    <Label Content="股票代码" />
                    <TextBox x:Name="CodeBox" Text="002241" Margin="0,0,0,16" />

                    <Label Content="上限价格" />
                    <TextBox x:Name="UpperBox" Text="26" Margin="0,0,0,16" />

                    <Label Content="下限价格" />
                    <TextBox x:Name="LowerBox" Text="22" Margin="0,0,0,16" />

                    <Label Content="刷新秒数" />
                    <TextBox x:Name="IntervalBox" Text="3" Margin="0,0,0,24" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="StartButton"
                                Grid.Column="0"
                                Content="开始监测"
                                Click="StartButton_Click"
                                Background="{StaticResource PrimaryBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                Foreground="White" />

                        <Button x:Name="StopButton"
                                Grid.Column="2"
                                Content="停止"
                                Click="StopButton_Click"
                                IsEnabled="False"
                                Background="#EEF2F8"
                                BorderBrush="#D9E0EC"
                                Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="当前价" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="PriceText" Text="--" FontSize="46" FontWeight="Bold" Margin="0,10,0,0" />
                            <TextBlock x:Name="CodeText" Text="002241" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="涨跌" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="ChangeText" Text="--" FontSize="26" FontWeight="SemiBold" Margin="0,16,0,0" />

                            <TextBlock Text="今开 / 昨收" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,0" />
                            <TextBlock x:Name="OpenCloseText" Text="--" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                            <TextBlock Text="最高 / 最低" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="RangeText" Text="--" FontSize="26" FontWeight="SemiBold" Margin="0,16,0,0" />

                            <TextBlock Text="阈值" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,0" />
                            <TextBlock x:Name="ThresholdText" Text="26 / 22" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="监测日志" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />
                        <ListBox x:Name="LogList"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Background="#FFFFFF" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
