<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nu="clr-namespace:FrameWork.UserControls.NumericUpDown"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:vm="clr-namespace:EEGTool.ViewModels">
    <DataTemplate DataType="{x:Type vm:SettingsHomeViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid Background="White">
                <Border>

                    <Border.Background>
                        <LinearGradientBrush
                        StartPoint="1,0"
                        EndPoint="0,1">
                            <GradientStop
                            Color="#FFFFFF"
                            Offset="0" />
                            <GradientStop
                            Color="#D4EAFF"
                            Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">

                    <Button Style="{StaticResource HomeIconButtonStyle}"
                        Margin="8,0,0,3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Command="{Binding BackHomeCommand}"
                        ToolTip="返回首页">
                        <iconPacks:PackIconGameIcons Kind="Brain"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="#4D4D4D" />
                    </Button>

                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Width="1" Background="LightGray"
                      Margin="15,5"></Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Width="400" Height="600">

                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush
                StartPoint="1,0"
                EndPoint="0,1">
                            <GradientStop
                    Color="#FFFFFF"
                    Offset="0" />
                            <GradientStop
                    Color="#D4EAFF"
                    Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>


                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.25"
                              Color="#000000"/>
                    </Border.Effect>
                </Border>
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="系统设置" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Border Height="1" 
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Background="LightGray" 
                                Margin="10,0"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="10,0,10,88"
                                  VerticalScrollBarVisibility="Hidden">

                        <StackPanel>
                            <Grid HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Height="80"
                                    Margin="10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock HorizontalAlignment="Left"
                                         VerticalAlignment="Bottom"
                                         Margin="5,0,0,5"
                                         Text="BLE配置"
                                         Foreground="CadetBlue"/>

                                <Border Grid.Row="1" 
                                          BorderThickness="1" 
                                          CornerRadius="5"
                                          BorderBrush="CadetBlue">

                                    <Grid HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Orientation="Horizontal">
                                            <TextBlock Text="目标特征:" VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>

                                            <TextBox
                                                Width="250"
                                                Height="25"
                                                VerticalContentAlignment="Center"
                                                FontSize="11"
                                                Text="{Binding BleTargetServiceUuidInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="BorderBrush" Value="LightGray"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Padding" Value="4,0"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="5">
                                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>


                            <Grid HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Height="185"
                                    Margin="10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock HorizontalAlignment="Left"
                                         VerticalAlignment="Bottom"
                                         Margin="5,0,0,5"
                                         Text="阻抗监测"
                                         Opacity="1"
                                         Foreground="Orange"/>

                                <Border Grid.Row="1" 
                                          BorderThickness="1" 
                                          CornerRadius="5"
                                          BorderBrush="Orange"
                                          Opacity="1">

                                    <Grid HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35"/>
                                            <RowDefinition Height="35"/>
                                            <RowDefinition Height="35"/>
                                            <RowDefinition Height="35"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Orientation="Horizontal">
                                            <TextBlock Text="目标频率:" VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>

                                            <nu:BZNumericUpDown
                                                  VerticalAlignment="Center"
                                                  Width="150"
                                                  Height="25"
                                                 MaxValue="600"
                                                 MinValue="0"
                                                 IsDecimal="True"
                                                 Value="{Binding ImpedanceTargetValue}"
                                                 Step="0.1" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="电流数值:" VerticalAlignment="Center"
                                                     Margin="0,0,10,0"/>

                                            <nu:BZNumericUpDown
                                                     VerticalAlignment="Center"
                                                     Width="150"
                                                     Height="25"
                                                     MaxValue="0.0000006"
                                                     MinValue="0"
                                                     IsDecimal="True"
                                                     IsScientificNotation="True"
                                                     Value="{Binding ImpedanceLeafOff}"
                                                     Step="0.000000001" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Orientation="Horizontal">
                                            <TextBlock Text="阻抗增益:" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                            <nu:BZNumericUpDown
                                                  Width="150"
                                                  VerticalAlignment="Center"
                                                  Height="25"
                                                  MaxValue="100"
                                                  MinValue="0"
                                                  IsDecimal="True"
                                                  Value="{Binding ImpedanceGainNum}"
                                                  Step="1" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="3"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Orientation="Horizontal">
                                            <TextBlock Text="串联电阻:" VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>

                                            <nu:BZNumericUpDown
                                                    Width="150"
                                                    VerticalAlignment="Center"
                                                    Height="25"
                                                    MaxValue="100"
                                                    MinValue="0"
                                                    IsDecimal="True"
                                                    Value="{Binding SeriesResistorKohm}"
                                                    Step="1" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                    </ScrollViewer>

                    <Grid Grid.Row="1"
                        Height="88" VerticalAlignment="Bottom"
                          HorizontalAlignment="Stretch">
                        <Border x:Name="SaveButtonBorder"
                            CornerRadius="10"
                            BorderThickness="0.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="LightGray"/>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.35"
                                  Color="#66000000"/>
                            </Border.Effect>
                            <Button Style="{StaticResource EffectActionButtonStyle}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Width="135"
                                   Height="35"
                                   FontSize="14"
                                   Content="保 存"
                                   Command="{Binding SaveCommand}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
