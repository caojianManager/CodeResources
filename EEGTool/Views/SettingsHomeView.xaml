<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:vm="clr-namespace:EEGTool.ViewModels">
    <DataTemplate DataType="{x:Type vm:SettingsHomeViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid Background="White">
                <Border>

                    <Border.Background>
                        <LinearGradientBrush
                        StartPoint="1,0"
                        EndPoint="0,1">
                            <GradientStop
                            Color="#FFFFFF"
                            Offset="0" />
                            <GradientStop
                            Color="#D4EAFF"
                            Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">

                    <Button Style="{StaticResource HomeIconButtonStyle}"
                        Margin="8,0,0,3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Command="{Binding BackHomeCommand}"
                        ToolTip="返回首页">
                        <iconPacks:PackIconGameIcons Kind="Brain"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="#4D4D4D" />
                    </Button>

                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Width="1" Background="LightGray"
                      Margin="15,5"></Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Width="400" Height="600">

                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush
                StartPoint="1,0"
                EndPoint="0,1">
                            <GradientStop
                    Color="#FFFFFF"
                    Offset="0" />
                            <GradientStop
                    Color="#D4EAFF"
                    Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>


                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                              ShadowDepth="2"
                              Direction="270"
                              Opacity="0.25"
                              Color="#000000"/>
                    </Border.Effect>
                </Border>
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="系统设置" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Border Height="1" 
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Background="LightGray" 
                                Margin="10,0"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="10,0,10,50"
                                  VerticalScrollBarVisibility="Hidden">

                        <Grid HorizontalAlignment="Stretch"
                              VerticalAlignment="Top"
                              Height="300"
                              Margin="10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,5"
                                       Text="阻抗监测"
                                       Foreground="Orange"/>

                            <Border Grid.Row="1" 
                                    BorderThickness="1" 
                                    CornerRadius="5"
                                    BorderBrush="Orange"></Border>
                        </Grid>
                        
                    </ScrollViewer>

                    <Grid Height="50" VerticalAlignment="Bottom"
                          HorizontalAlignment="Stretch">
                        <Button Style="{StaticResource EffectActionButtonStyle}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             Width="135"
                             Height="35"
                             FontSize="14"
                             Command="{Binding CollectionCommand}" Cursor=""/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>