<UserControl x:Class="EEGTool.Views.Impedance.ImpedanceEEGView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
             xmlns:cv="clr-namespace:FrameWork.Converts"
             xmlns:nu="clr-namespace:FrameWork.UserControls.NumericUpDown"
             xmlns:local="clr-namespace:EEGTool.Views.Impedance"
             xmlns:vm="clr-namespace:EEGTool.ViewModels.Impedance"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.DataContext>
        <vm:ImpedanceEEGViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <cv:BoolToBrushConverter
            x:Key="IsEnableBrush"
            TrueBrush="LightGray"
            FalseBrush="#0D0D0D"></cv:BoolToBrushConverter>
        <cv:InverseBoolConverter
            x:Key="InverseBool" />
        <Style
            x:Key="ComboBoxStyle"
            TargetType="ComboBox">
            <Setter
                Property="Foreground"
                Value="Black" />
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="ComboBox">
                        <Grid>
                            <!-- 边框 -->
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2" />

                            <!-- 显示选中项 -->
                            <ContentPresenter
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}" />


                            <ToggleButton
                                x:Name="PART_DropDownToggle"
                                Focusable="False"
                                Cursor="Hand"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                BorderThickness="0"
                                Background="Transparent">
                                <ToggleButton.Template>
                                    <ControlTemplate
                                        TargetType="ToggleButton">
                                        <Border
                                            x:Name="Border"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0">
                                            <Path
                                                Data="M 0 0 L 8 8 L 16 0 Z"
                                                Fill="Black"
                                                Width="10"
                                                Height="6"
                                                Margin="0,0,10,0"
                                                Stretch="Uniform"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger
                                                Property="IsMouseOver"
                                                Value="True">
                                                <Setter
                                                    TargetName="Border"
                                                    Property="Background"
                                                    Value="Transparent" />
                                            </Trigger>
                                            <Trigger
                                                Property="IsPressed"
                                                Value="True">
                                                <Setter
                                                    TargetName="Border"
                                                    Property="Background"
                                                    Value="Transparent" />
                                            </Trigger>
                                            <Trigger
                                                Property="IsEnabled"
                                                Value="False">
                                                <Setter
                                                    TargetName="Border"
                                                    Property="Opacity"
                                                    Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>


                            <!-- 下拉列表 -->
                            <Popup
                                x:Name="PART_Popup"
                                VerticalOffset="5"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide"
                                IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border
                                    Background="LightGray"
                                    CornerRadius="0"
                                    BorderThickness="1"
                                    BorderBrush="LightGray"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <StackPanel
                                            IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions> 

        <Grid Background="WhiteSmoke">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#F8FAFC"
                     BorderBrush="#E2E8F0"
                     BorderThickness="0,0,0,1">
                <TextBlock Text="EEG"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            Foreground="#334155"
                            FontWeight="SemiBold"/>
            </Border>


            <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,15,0">
                <TextBlock Text="窗口时间(s)"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               Foreground="#334155"
                               FontWeight="SemiBold"/>
                <TextBlock Text="垂直刻度(uV)"
                               Margin="8,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding IsAuto,Converter={StaticResource IsEnableBrush}}" 
                               FontWeight="SemiBold"/>
                <TextBlock Text="自动"
                               Margin="20,0,26,0"
                               VerticalAlignment="Center"
                               Foreground="#334155"
                               FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Margin="0,0,15,0">
                <nu:BZNumericUpDown
               Width="80"
               Height="25"
               MaxValue="15"
               MinValue="1"
               IsDecimal="False"
               Value="{Binding WindowSec}"
               Step="1" />
                <nu:BZNumericUpDown
               Margin="5,0,0,0"
               MaxValue="10000"
               Width="80"
               Height="25"
               MinValue="1"
               IsEnabled="{Binding IsAuto,Converter={StaticResource InverseBool}}"
               IsDecimal="False"
               Foreground="{Binding IsAuto,Converter={StaticResource IsEnableBrush}}"
               Value="{Binding VertScale}"
               Step="10" />

                <ComboBox Width="65"
                     Height="25"
                     FontSize="11"
                     Margin="5,0,0,0"
                     SelectedIndex="{Binding AutoModeSelectedIndex, Mode=TwoWay}"
                     Style="{StaticResource ComboBoxStyle}">
                    <ComboBoxItem Content="否"/>
                    <ComboBoxItem Content="是"/>
                </ComboBox>
            </StackPanel>

            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Bottom"
                  Background="Gray"
                  Height="1"></Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid Width="1" Background="Gray"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Right"
                      Margin="0,15,0,36"></Grid>
            </Grid>
      
            <Canvas Grid.Column="1"
                Width="100"
                ClipToBounds="True"
                Background="White"
                Margin="15,0,0,12">
                <ItemsControl ItemsSource="{Binding ChannelHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style>
                            <Setter Property="Canvas.Top" Value="{Binding ItemOffsetY}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                  Width="80"
                                  Height="{Binding ItemHeight}"
                                  Opacity="{Binding OpacityValue}">
                                <Border
                                    BorderThickness="1"
                                    BorderBrush="LightGray"
                                    CornerRadius="25"
                                    Width="50"
                                    Height="50"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding ImpedanceColor}" >
                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding EleTag}"
                                            Margin="0,0,0,0"
                                            Foreground="White"
                                            FontSize="11"
                                            TextTrimming="CharacterEllipsis"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Grid Height="1" Background="White"></Grid>
                                        <TextBlock
                                            Text="{Binding ChannelId}"
                                            Margin="0,0,0,0"
                                            Foreground="White"
                                            FontSize="11"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                               
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>

            <ContentControl
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,0,12,12"
                SizeChanged="ScottPlotEEG_SizeChanged"
                Content="{Binding ScottPlotEEG, Mode=OneTime}"/>

            <Canvas Grid.Column="1"
                    Grid.ColumnSpan="2"
                    IsHitTestVisible="False"
                    ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding ChannelDividerItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style>
                            <Setter Property="Canvas.Top" Value="{Binding ItemOffsetY}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="0"
                                  X2="100"
                                  Y1="0"
                                  Y2="0"
                                  Stroke="Gray"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>

            <Line Grid.Column="1"
                  Grid.ColumnSpan="2"
                  HorizontalAlignment="Left"
                  StrokeThickness="1" 
                  VerticalAlignment="Top"
                  Margin="0,16,0,0"
                  X1="0"
                  X2="100"
                  Y1="0"
                  Y2="0"
                  Stroke="Gray"/>

            <Line Grid.Column="1"
                  Grid.ColumnSpan="2"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,36"
                  X1="0"
                  X2="100"
                  Y1="0"
                  Y2="0"
                  Stroke="Gray" />
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2" BorderThickness="1" BorderBrush="Gray"/>
    </Grid>
</UserControl>
