<UserControl x:Class="EEGTool.Views.YelloSpot.YelloSpotCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EEGTool.Views.YelloSpot"
             xmlns:gl="clr-namespace:FrameWork.OpenGLWindows"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="MagnifierSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    Background="LightGray"
                                    CornerRadius="10"/>
                            <Border x:Name="Thumb"
                                    Width="15"
                                    Height="15"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#EEF4F8"
                                    CornerRadius="10"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#8DCCFA"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                  
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <gl:OpenGLWindows  RenderAction="OpenTkControl_OnRender" Init="OpenTkControl_Init"/>

        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Background="WhiteSmoke">

                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="0,0,10,0">
                    <ScrollViewer Margin="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="放大镜功能" Foreground="Gray"
                                       FontSize="14"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="10,15,0,0"/>
                            <Grid Height="0.5" Margin="10,5,10,0" Background="LightGray"/>

                            <StackPanel Orientation="Horizontal" Margin="10,5">
                                <TextBlock Text="是否开启:" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <ToggleButton Margin="8,0,0,0"
                                              Style="{StaticResource MagnifierSwitchStyle}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsMagnifierEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:YelloSpotCaptureView}}, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="10,5">
                                <TextBlock Text="半径数值:" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Slider Width="150"
                                        Minimum="0"
                                        Maximum="50"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Value="{Binding MagnifierRadius, RelativeSource={RelativeSource AncestorType={x:Type local:YelloSpotCaptureView}}, Mode=TwoWay}"/>
                                <TextBlock Width="32"
                                           Margin="8,0,0,0"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{Binding MagnifierRadius, RelativeSource={RelativeSource AncestorType={x:Type local:YelloSpotCaptureView}}, StringFormat={}{0:0}}"/>
                            </StackPanel>

                            <TextBlock Text="摄像机深度" Foreground="Gray"
                                FontSize="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10,15,0,0"/>
                            <Grid Height="0.5" Margin="10,5,10,0" Background="LightGray"/>

                            <StackPanel Orientation="Horizontal" Margin="10,5">
                                <TextBlock Text="深度值范围:" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Slider Width="150"
                                        Minimum="1"
                                        Maximum="5"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Value="{Binding CameraDepthRange, RelativeSource={RelativeSource AncestorType={x:Type local:YelloSpotCaptureView}}, Mode=TwoWay}"/>
                                <TextBlock Width="32"
                                           Margin="8,0,0,0"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{Binding CameraDepthRange, RelativeSource={RelativeSource AncestorType={x:Type local:YelloSpotCaptureView}}, StringFormat={}{0:0.0}x}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                
                <Grid Width="10" VerticalAlignment="Stretch" HorizontalAlignment="Right" Background="#BADEFF">
                    <Button Margin="0"
                           Padding="0"
                           Background="Transparent"
                           BorderBrush="Transparent"
                           BorderThickness="0"
                             Click="DetailPanel_Click"
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch">
                        <iconPacks:PackIconForkAwesome  x:Name="DetailPanelBtnArrow"
                             Kind="AngleDoubleLeft" 
                              Width="8" Height="13"
                              Foreground="Black"/>
                    </Button>
                </Grid>
            </Grid>
            <Grid Grid.Column="1"></Grid>
        </Grid>
    </Grid>
</UserControl>
