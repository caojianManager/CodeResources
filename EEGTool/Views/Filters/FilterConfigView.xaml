<Window x:Class="EEGTool.Views.Filters.FilterConfigView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EEGTool.Views.Filters"
        xmlns:nu="clr-namespace:FrameWork.UserControls.NumericUpDown"
        xmlns:vm="clr-namespace:EEGTool.ViewModels.Filters"
        mc:Ignorable="d"
        Title="滤波器" Height="600" Width="350"
        MinHeight="600" MaxHeight="600"
        MinWidth="350" MaxWidth="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:FilterConfigViewModel/>
    </Window.DataContext>
    
    <Grid>
        <ScrollViewer Margin="10" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,15,0,0">
                <TextBlock Text="带通滤波(BandPass)" 
                           Foreground="Gray"
                           FontSize="14"/>
                <Grid Height="0.5" Background="LightGray" Margin="0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Start(Hz) :" FontSize="12"
                               Foreground="Green"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                    <nu:BZNumericUpDown
                       Width="80"
                       Height="25"
                       VerticalAlignment="Center"
                       MaxValue="15"
                       MinValue="1"
                       IsDecimal="False"
                       Value="{Binding BandPassStartHz}"
                       Step="1" />

                    <TextBlock Text="Stop(Hz) :" FontSize="12"
                                VerticalAlignment="Center"
                                Margin="15,0,15,0"
                               Foreground="Red"/>
                    <nu:BZNumericUpDown
                                Width="80"
                                Height="25"
                                VerticalAlignment="Center"
                                MaxValue="15"
                                MinValue="1"
                                IsDecimal="False"
                                Value="{Binding BandPassStopHz}"
                                Step="1" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
